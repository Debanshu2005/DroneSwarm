[Unit]
Description=PhoneOS Drone3 Unified Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi4
WorkingDirectory=/home/pi4/DroneSwarm
Environment="PYTHONPATH=/home/pi4/DroneSwarm"

# Resource constraints to prevent SSH lockout
CPUQuota=70%
MemoryMax=1500M
MemoryHigh=1200M
IOWeight=50
OOMScoreAdjust=500
Nice=5
ExecStart=/home/pi4/DroneSwarm/venv/bin/python start_drone3.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
