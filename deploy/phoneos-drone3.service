[Unit]
[Unit]
Description=PhoneOS Drone3 Unified Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi4
WorkingDirectory=/home/pi4/DroneSwarm
Environment="PYTHONPATH=/home/pi4/DroneSwarm"

# Resource constraints for Pi 3B (1GB RAM)
CPUQuota=80%
MemoryMax=750M
MemoryHigh=600M
OOMScoreAdjust=500
Nice=5
ExecStart=/home/pi4/DroneSwarm/venv/bin/python start_drone3.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
