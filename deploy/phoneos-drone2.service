[Unit]
Description=PhoneOS Drone2 Unified Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi2
WorkingDirectory=/home/pi2/Projects/PhoneOS
Environment="PYTHONPATH=/home/pi2/Projects/PhoneOS"

# Resource constraints to prevent SSH lockout
CPUQuota=70%
MemoryMax=1500M
MemoryHigh=1200M
IOWeight=50
OOMScoreAdjust=500
Nice=5
ExecStart=/home/pi2/Projects/PhoneOS/venv/bin/python start_drone2.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
