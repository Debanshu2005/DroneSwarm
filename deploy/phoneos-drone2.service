[Unit]
Description=PhoneOS Drone2 Unified Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi2
WorkingDirectory=/home/pi2/Projects/PhoneOS
Environment="PYTHONPATH=/home/pi2/Projects/PhoneOS"

# Resource constraints for Pi 3B (1GB RAM)
CPUQuota=80%
MemoryMax=750M
MemoryHigh=600M
IOWeight=50
OOMScoreAdjust=500
Nice=5
ExecStart=/home/pi2/Projects/PhoneOS/venv/bin/python start_drone2.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
