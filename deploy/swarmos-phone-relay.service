[Unit]
Description=SwarmOS PhoneOS Relay Service
After=droneos.service network-online.target
Wants=droneos.service network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/SwarmOS
ExecStart=/opt/SwarmOS/venv/bin/python3 relay/relay.py
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/SwarmOS
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
