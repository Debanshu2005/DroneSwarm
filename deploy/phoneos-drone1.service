[Unit]
Description=PhoneOS Drone1 Unified Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/DroneSwarm
Environment="PYTHONPATH=/home/pi/DroneSwarm"
Environment="DRONEOS_PERCEPTION=1"

# Resource constraints for Raspberry Pi
CPUQuota=250%
MemoryMax=2500M
MemoryHigh=2000M
IOWeight=100
OOMScoreAdjust=0
Nice=-2

ExecStart=/home/pi/DroneSwarm/venv/bin/python start_drone1.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
