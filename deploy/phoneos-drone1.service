[Unit]
Description=PhoneOS Drone1 Unified Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/PhoneOS
Environment="PYTHONPATH=/home/pi/Projects/PhoneOS"
ExecStart=/home/pi/Projects/PhoneOS/venv/bin/python start_drone1.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
