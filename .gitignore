# ==============================================================================
# DroneSwarm Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
.venv/
.venv-gpu/
.env/

# Testing & quality caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/

# ------------------------------------------------------------------------------
# Environment, Logs & System Files
# ------------------------------------------------------------------------------
.env
.env.*
*.log
logs/
graphify-out/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary root scratch outputs
/*.txt
!/requirements*.txt
/*.json
!/sim/airsim/settings.json

# ------------------------------------------------------------------------------
# Mobile & Frontend Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/dist/
mobile/www/

# ------------------------------------------------------------------------------
# Machine Learning: Datasets, Caches, & Training Runs
# ------------------------------------------------------------------------------
# Large archives
*.tar.gz
*.zip

# Dataset directories (UAVVaste, raw images, YOLO labels, splits)
ml/data/

# Label and image caches generated by YOLO / Ultralytics
*.cache
labels.cache
images.cache

# Training runs, experiment logs, and checkpoints
runs/
ml/runs/
ml/reports/smoke_test_output/
wandb/
tensorboard/
*.tfevents*

# Pretrained base weights downloaded by Ultralytics
yolo*.pt
*.engine
*.ckpt

# ------------------------------------------------------------------------------
# Production Artifact Preservation (Explicit Whitelist)
# ------------------------------------------------------------------------------
!models/garbage.pt
!ml/model_metadata.json
!sim/airsim/settings.json
